<UserControl x:Class="ShmViewer.Views.DatInputView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ShmViewer"
 AllowDrop="True" Drop="Input_Drop" DragOver="Input_DragOver">
 <Border Background="#25282D" BorderBrush="#484B51" BorderThickness="1" Padding="8" Margin="2">
  <StackPanel>
   <TextBlock Text="{Binding Label}" Foreground="#9CDCFE" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
   <CheckBox Content="Use SCTC Path" IsChecked="{Binding UseSctcPath}" Foreground="#E0E0E0" Margin="0,0,0,6"/>
   <DockPanel Margin="0,0,0,3">
    <Button Content="+ 헤더" Command="{Binding AddHeadersCommand}" Style="{DynamicResource DarkBtn}"/>
    <Button Content="삭제" Command="{Binding RemoveHeaderCommand}" Margin="4,0"/>
    <Button Content="↑" Command="{Binding MoveHeaderCommand}" CommandParameter="up" Padding="6,0"/>
    <Button Content="↓" Command="{Binding MoveHeaderCommand}" CommandParameter="down" Padding="6,0" Margin="4,0"/>
    <TextBlock Text="위에서부터 include" Foreground="#999" FontSize="10"/>
   </DockPanel>
   <ListBox x:Name="HeaderList" ItemsSource="{Binding Headers}" SelectionMode="Extended" SelectionChanged="Headers_SelectionChanged" PreviewKeyDown="Headers_KeyDown" Height="66" Background="#1E2023" BorderBrush="#444">
    <ListBox.ItemTemplate><DataTemplate>
     <TextBlock ToolTip="{Binding Path}">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D4D4D4"/><Style.Triggers>
       <DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Foreground" Value="#FF7777"/></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
      <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Error, Mode=OneWay}"/>
     </TextBlock>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <DockPanel Margin="0,5,0,0">
    <Button DockPanel.Dock="Right" Content="DAT…" Command="{Binding ChooseDatCommand}" Margin="4,0,0,0"/>
    <TextBox Text="{Binding DatPath, UpdateSourceTrigger=LostFocus}" ToolTip="DAT 파일 경로"/>
   </DockPanel>
   <DockPanel Margin="0,5,0,0">
    <TextBlock Text="Struct " Width="52"/><TextBox Text="{Binding StructName, UpdateSourceTrigger=LostFocus}"/>
   </DockPanel>
   <Expander x:Name="OptionsExpander" Header="파싱 옵션 · Windows x64" Foreground="#BBBBBB" Margin="0,5,0,0">
    <StackPanel Margin="0,4,0,0">
     <DockPanel><TextBlock Text="기본 Pack " Width="82"/><TextBox Text="{Binding Pack}" Width="45" HorizontalAlignment="Left"/></DockPanel>
     <TextBlock Text="추가 include 경로 (줄마다 하나)" Margin="0,4,0,2"/>
     <TextBox Text="{Binding IncludeDirectories}" AcceptsReturn="True" Height="45" VerticalScrollBarVisibility="Auto"/>
     <TextBlock Text="매크로 NAME 또는 NAME=VALUE (줄마다 하나)" Margin="0,4,0,2"/>
     <TextBox Text="{Binding Defines}" AcceptsReturn="True" Height="45" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
   </Expander>
  </StackPanel>
 </Border>
</UserControl>
